generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum NovelStatus { DRAFT PLANNING GENERATING PAUSED COMPLETED ARCHIVED }
enum ChapterStatus { PLANNED GENERATING GENERATED VALIDATING REVISION_REQUIRED REVIEW APPROVED FINALIZING CANONICAL }
enum GenerationJobStatus { QUEUED RUNNING SUCCEEDED FAILED CANCELLED }
model Novel { id String @id @default(cuid()) title String premise String? language String @default("vi") genre String? tone String? status NovelStatus @default(DRAFT) targetChapters Int? chapterWordGoal Int? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt storyBibles StoryBible[] characters Character[] arcs Arc[] chapters Chapter[] plotThreads PlotThread[] foreshadowing Foreshadowing[] generationJobs GenerationJob[] memories Memory[] }
model StoryBible { id String @id @default(cuid()) novelId String version Int logline String? synopsis String? themes Json? worldRules Json? powerSystem Json? narrativeRules Json? styleRules Json? endingDirection Json? isCanonical Boolean @default(false) createdAt DateTime @default(now()) novel Novel @relation(fields:[novelId],references:[id],onDelete:Cascade) @@unique([novelId,version]) }
model Character { id String @id @default(cuid()) novelId String name String aliases Json? role String? description String? personality Json? goals Json? fears Json? motivation String? background String? currentState Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt novel Novel @relation(fields:[novelId],references:[id],onDelete:Cascade) @@index([novelId]) }
model Arc { id String @id @default(cuid()) novelId String number Int title String summary String? objective String? conflict String? chapterStart Int? chapterEnd Int? status String @default("PLANNED") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt novel Novel @relation(fields:[novelId],references:[id],onDelete:Cascade) chapters Chapter[] @@unique([novelId,number]) }
model Chapter { id String @id @default(cuid()) novelId String arcId String? number Int title String? plan Json? content String? summary String? status ChapterStatus @default(PLANNED) wordCount Int? version Int @default(1) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt novel Novel @relation(fields:[novelId],references:[id],onDelete:Cascade) arc Arc? @relation(fields:[arcId],references:[id],onDelete:SetNull) @@unique([novelId,number,version]) }
model PlotThread { id String @id @default(cuid()) novelId String title String description String introducedChapter Int? targetPayoffChapter Int? status String @default("SETUP") importance Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt novel Novel @relation(fields:[novelId],references:[id],onDelete:Cascade) }
model Foreshadowing { id String @id @default(cuid()) novelId String description String introducedChapter Int? plannedPayoffChapter Int? payoffDescription String? status String @default("PLANNED") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt novel Novel @relation(fields:[novelId],references:[id],onDelete:Cascade) }
model GenerationJob { id String @id @default(cuid()) novelId String type String inputSnapshot Json? provider String? model String? status GenerationJobStatus @default(QUEUED) attempt Int @default(0) output Json? error String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt novel Novel @relation(fields:[novelId],references:[id],onDelete:Cascade) }
model Memory { id String @id @default(cuid()) novelId String chapterId String? category String title String content String importance Int @default(0) metadata Json? createdAt DateTime @default(now()) novel Novel @relation(fields:[novelId],references:[id],onDelete:Cascade) }
