generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum NovelStatus {
  DRAFT
  PLANNING
  GENERATING
  PAUSED
  COMPLETED
  ARCHIVED
}

enum NovelGenerationState {
  DRAFT
  INITIALIZING
  ARCHITECTING
  PLANNING
  GENERATING_CHAPTERS
  GENERATING_SCENES
  GENERATING_PROSE
  PAUSED
  COMPLETED
  FAILED
  BLOCKED
}

enum ChapterStatus {
  PLANNED
  GENERATING
  GENERATED
  VALIDATING
  REVISION_REQUIRED
  REVIEW
  APPROVED
  FINALIZING
  CANONICAL
}

enum GenerationJobStatus {
  QUEUED
  CLAIMED
  RUNNING
  SUCCEEDED
  FAILED
  RETRY_PENDING
  BLOCKED
  CANCELLED
}

enum ArchitectStage {
  CONCEPT
  PREMISE
  GENRE_AND_TONE
  THEMES
  WORLD
  POWER_SYSTEM
  CHARACTERS
  FACTIONS
  CONFLICTS
  PLOT_THREADS
  CHARACTER_ARCS
  FORESHADOWING
  LONG_TERM_STRUCTURE
  STORY_BIBLE_FINALIZATION
}

enum ArchitectStatus {
  NOT_STARTED
  RUNNING
  COMPLETED
  FAILED
  STALE
}

model Novel {
  id              String      @id @default(cuid())
  title           String
  premise         String?
  language        String      @default("vi")
  genre           String?
  tone            String?
  status          NovelStatus @default(DRAFT)
  targetChapters  Int?
  chapterWordGoal Int?

  architectStage  ArchitectStage?
  architectStatus ArchitectStatus? @default(NOT_STARTED)

  // Phase 8: Autonomous generation configuration
  generationState       NovelGenerationState @default(DRAFT)
  autoContinue          Boolean              @default(false)
  autoGenerateScenes    Boolean              @default(true)
  autoGenerateProse     Boolean              @default(true)
  maxConcurrentJobs     Int                  @default(3)
  chapterBatchSize      Int                  @default(10)
  generationWindowSize  Int                  @default(2)
  maxGenerationCostUsd  Float?
  correlationId         String?

  // Phase 9: Continuity tracking
  currentStoryStateId   String?   // Points to latest canonical StoryState
  lastCanonicalChapter  Int       @default(0)
  continuityEnabled     Boolean   @default(true)

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  storyBibles    StoryBible[]
  characters     Character[]
  arcs           Arc[]
  chapters       Chapter[]
  plotThreads    PlotThread[]
  foreshadowing  Foreshadowing[]
  generationJobs GenerationJob[]
  memories       Memory[]
  locations      Location[]
  items          Item[]
  factions       Faction[]
  relationships  Relationship[]
  events         Event[]
  storyPlan      StoryPlan?
  consequences   Consequence[]
  snapshots      ContinuitySnapshot[]
  storyStates    StoryStateRecord[]
  chapterMemories ChapterMemoryRecord[]
  qualitySnapshots QualitySnapshotRecord[]
  qualityTrends   QualityTrendRecord[]
  longHorizonPlans LongHorizonPlan[]
}

model StoryBible {
  id              String   @id @default(cuid())
  novelId         String
  version         Int
  logline         String?
  synopsis        String?
  themes          Json?
  worldRules      Json?
  powerSystem     Json?
  narrativeRules  Json?
  styleRules      Json?
  endingDirection Json?
  isCanonical     Boolean  @default(false)
  createdAt       DateTime @default(now())
  novel           Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, version])
}

model Character {
  id            String         @id @default(cuid())
  novelId       String
  name          String
  aliases       Json?
  role          String?
  description   String?
  personality   Json?
  goals         Json?
  fears         Json?
  motivation    String?
  background    String?
  currentState  Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  novel         Novel          @relation(fields: [novelId], references: [id], onDelete: Cascade)
  characterArcs CharacterArc[]

  @@index([novelId])
}

model Location {
  id          String   @id @default(cuid())
  novelId     String
  name        String
  description String?
  region      String?
  traits      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  novel       Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model Item {
  id          String   @id @default(cuid())
  novelId     String
  name        String
  description String?
  properties  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  novel       Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model Faction {
  id          String   @id @default(cuid())
  novelId     String
  name        String
  description String?
  goals       String?
  traits      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  novel       Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model Relationship {
  id          String   @id @default(cuid())
  novelId     String
  sourceId    String
  sourceType  String
  targetId    String
  targetType  String
  description String?
  dynamic     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  novel       Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, sourceId])
}

model Event {
  id                 String   @id @default(cuid())
  novelId            String
  title              String
  description        String?
  chapterId          String?
  chronologicalOrder Int      @default(0)
  timestamp          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  novel              Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model Arc {
  id           String    @id @default(cuid())
  novelId      String
  number       Int
  title        String
  summary      String?
  objective    String?
  conflict     String?
  chapterStart Int?
  chapterEnd   Int?
  status       String    @default("PLANNED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  novel        Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapters     Chapter[]
  sagaId       String?
  saga         Saga?     @relation(fields: [sagaId], references: [id], onDelete: SetNull)

  @@unique([novelId, number])
}

model Chapter {
  id                 String             @id @default(cuid())
  novelId            String
  arcId              String?
  number             Int
  title              String?
  plan               Json?
  content            String?
  summary            String?
  status             ChapterStatus      @default(PLANNED)
  wordCount          Int?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  novel              Novel              @relation(fields: [novelId], references: [id], onDelete: Cascade)
  arc                Arc?               @relation(fields: [arcId], references: [id], onDelete: SetNull)
  miniArcId          String?
  miniArc            MiniArc?           @relation(fields: [miniArcId], references: [id], onDelete: SetNull)
  chapterBlueprintId String?
  chapterBlueprint   ChapterBlueprint?  @relation(fields: [chapterBlueprintId], references: [id], onDelete: SetNull)
  scenePlanVersions  ScenePlanVersion[]
  chapterProse       ChapterProse?

  @@unique([novelId, number, version])
}

model PlotThread {
  id                  String   @id @default(cuid())
  novelId             String
  title               String
  description         String
  introducedChapter   Int?
  targetPayoffChapter Int?
  status              String   @default("SETUP")
  importance          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  novel               Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

model Foreshadowing {
  id                   String   @id @default(cuid())
  novelId              String
  description          String
  introducedChapter    Int?
  plannedPayoffChapter Int?
  payoffDescription    String?
  status               String   @default("PLANNED")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  novel                Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

model GenerationJob {
  id      String @id @default(cuid())
  novelId String
  novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)

  stage        ArchitectStage?
  plannerStage PlannerStage?
  sceneStage   SceneStage?
  proseStage   ProseStage?
  status       GenerationJobStatus @default(QUEUED)
  provider     String?
  model        String?

  input  Json?
  output Json?
  error  Json?

  retryCount Int @default(0)
  maxRetries Int @default(3)

  idempotencyKey String? @unique

  lockedAt      DateTime?
  lockedBy      String?
  parentJobId   String?
  correlationId String?
  scheduledAt   DateTime?

  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  estimatedCostUsd Float?

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([novelId])
  @@index([status, scheduledAt])
  @@index([lockedAt])
}

model Memory {
  id         String                       @id @default(cuid())
  novelId    String
  chapterId  String?
  category   String
  title      String
  content    String
  importance Int                          @default(0)
  metadata   Json?
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())
  novel      Novel                        @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

enum PlanStatus {
  DRAFT
  CANONICAL
  STALE
}

enum PlannerStage {
  DESTINATION
  MACRO
  SAGA
  ARC
  MINI_ARC
  CHAPTER_BATCH
}

model StoryPlan {
  id        String             @id @default(cuid())
  novelId   String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  novel     Novel              @relation(fields: [novelId], references: [id], onDelete: Cascade)
  versions  StoryPlanVersion[]
}

model StoryPlanVersion {
  id          String    @id @default(cuid())
  planId      String
  version     Int
  isCanonical Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  plan        StoryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  destinations  StoryDestination[]
  macroPlans    MacroPlan[]
  sagas         Saga[]
  characterArcs CharacterArc[]
  batches       ChapterPlanningBatch[]

  @@unique([planId, version])
}

model StoryDestination {
  id                 String           @id @default(cuid())
  planVersionId      String
  intendedEnding     String?
  protagonistState   String?
  antagonistState    String?
  unresolvedQs       String?
  thematicResolution String?
  majorPayoffs       String?
  turningPoints      String?
  emotionalDest      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  planVersion        StoryPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
}

model MacroPlan {
  id                 String           @id @default(cuid())
  planVersionId      String
  targetChapterCount Int
  numberOfSagas      Int
  globalEscalation   String?
  midpoint           String?
  climax             String?
  ending             String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  planVersion        StoryPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
}

model Saga {
  id              String           @id @default(cuid())
  planVersionId   String
  number          Int
  title           String
  purpose         String?
  chapterStart    Int?
  chapterEnd      Int?
  primaryConflict String?
  resolution      String?
  unresolvedHooks String?
  status          PlanStatus       @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  planVersion     StoryPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  arcs            Arc[]
  miniArcs        MiniArc[]
}

model MiniArc {
  id           String     @id @default(cuid())
  sagaId       String
  number       Int
  title        String
  purpose      String?
  chapterStart Int?
  chapterEnd   Int?
  conflict     String?
  objective    String?
  turningPoint String?
  payoff       String?
  consequence  String?
  status       PlanStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  saga         Saga       @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  chapters     Chapter[]
}

model ChapterBlueprint {
  id                     String     @id @default(cuid())
  purpose                String?
  povCharacter           String?
  location               String?
  activeCharacters       Json?
  activePlotThreads      Json?
  activeConflicts        Json?
  setup                  String?
  progression            String?
  turningPoint           String?
  endingHook             String?
  foreshadowingUsed      Json?
  foreshadowingCreated   Json?
  characterDevelopment   String?
  continuityRequirements String?
  consequences           String?
  status                 PlanStatus @default(DRAFT)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  chapters               Chapter[]
}

model ChapterPlanningBatch {
  id              String           @id @default(cuid())
  planVersionId   String
  batchNumber     Int
  chapterStart    Int
  chapterEnd      Int
  status          String           @default("PENDING")
  generationJobId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  planVersion     StoryPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
}

model CharacterArc {
  id                         String           @id @default(cuid())
  planVersionId              String
  characterId                String
  startingState              String?
  currentState               String?
  targetState                String?
  milestones                 Json?
  emotionalProgression       String?
  unresolvedInternalConflict String?
  transformation             String?
  status                     String           @default("DRAFT")
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  planVersion                StoryPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  character                  Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Consequence {
  id          String   @id @default(cuid())
  novelId     String
  targetId    String
  targetType  String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  novel       Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

enum EntityType {
  CHARACTER
  ITEM
  LOCATION
  FACTION
  PLOT_THREAD
  FORESHADOWING
}

enum SceneStage {
  SCENE_PLAN
}

model ScenePlanVersion {
  id        String     @id @default(cuid())
  chapterId String
  version   Int
  status    PlanStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  scenes               Scene[]
  snapshot             ContinuitySnapshot?
  chapter              Chapter               @relation(fields: [chapterId], references: [id])
  chapterProseVersions ChapterProseVersion[]
}

model Scene {
  id                 String     @id @default(cuid())
  scenePlanVersionId String
  sceneNumber        Int
  status             PlanStatus @default(DRAFT)
  function           String
  povCharacter       String?
  location           String?
  time               String?
  objective          String?
  conflict           String?
  obstacle           String?
  escalation         String?
  turningPoint       String?
  outcome            String?
  emotionalBeat      String?
  informationControl Json?
  plotThreads        Json?
  foreshadowing      Json?
  transitionToNext   String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  stateChanges     StateChange[]
  scenePlanVersion ScenePlanVersion @relation(fields: [scenePlanVersionId], references: [id])
  sceneProses      SceneProse[]
}

model StateChange {
  id            String     @id @default(cuid())
  sceneId       String
  entityType    EntityType
  entityId      String
  property      String
  previousValue String?
  newValue      String
  reason        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  scene Scene @relation(fields: [sceneId], references: [id])
}

model ContinuitySnapshot {
  id                       String     @id @default(cuid())
  novelId                  String
  chapterNumber            Int
  status                   PlanStatus @default(DRAFT)
  previousSnapshotId       String?
  sourceScenePlanVersionId String?    @unique
  characters               Json?
  items                    Json?
  locations                Json?
  factions                 Json?
  plotThreads              Json?
  foreshadowing            Json?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  novel            Novel                @relation(fields: [novelId], references: [id])
  scenePlanVersion ScenePlanVersion?    @relation(fields: [sourceScenePlanVersionId], references: [id])
  previousSnapshot ContinuitySnapshot?  @relation("SnapshotLineage", fields: [previousSnapshotId], references: [id])
  nextSnapshots    ContinuitySnapshot[] @relation("SnapshotLineage")
}

enum ProseStatus {
  DRAFT
  CANONICAL
  STALE
  REJECTED
  HUMAN_EDITED
}

enum ProseStage {
  PROSE_GENERATION
}

model ChapterProse {
  id               String   @id @default(cuid())
  chapterId        String   @unique
  currentVersionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions ChapterProseVersion[]
  chapter  Chapter               @relation(fields: [chapterId], references: [id])
}

model ChapterProseVersion {
  id                       String      @id @default(cuid())
  chapterProseId           String
  sourceScenePlanVersionId String
  version                  Int
  status                   ProseStatus @default(DRAFT)
  generatedAt              DateTime    @default(now())
  provider                 String?
  model                    String?
  tokenMetadata            Json?

  sceneProseList         SceneProse[]
  chapterProse           ChapterProse     @relation(fields: [chapterProseId], references: [id])
  sourceScenePlanVersion ScenePlanVersion @relation(fields: [sourceScenePlanVersionId], references: [id])
}

model SceneProse {
  id                    String      @id @default(cuid())
  chapterProseVersionId String
  scenePlanId           String
  content               String
  wordCount             Int         @default(0)
  status                ProseStatus @default(DRAFT)
  validationReport      Json?
  generationMetadata    Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  chapterProseVersion ChapterProseVersion @relation(fields: [chapterProseVersionId], references: [id])
  scene               Scene               @relation(fields: [scenePlanId], references: [id])
}

// ====================================================================
// Phase 9: Canonical Story State
// ====================================================================

model StoryStateRecord {
  id            String   @id @default(cuid())
  novelId       String
  asOfChapter   Int
  // JSON representation of StoryState — structured but stored as Json for flexibility
  state         Json
  // Only one CANONICAL state per novel (the latest)
  isCanonical   Boolean  @default(false)
  snapshotId    String?  // linked ContinuitySnapshot
  createdAt     DateTime @default(now())
  novel         Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, asOfChapter])
  @@index([novelId, isCanonical])
}

// ====================================================================
// Phase 9: Chapter Memory — compact structured per-chapter memory
// ====================================================================

model ChapterMemoryRecord {
  id            String   @id @default(cuid())
  novelId       String
  chapterId     String   @unique
  chapterNumber Int
  summary       String
  keyEvents     Json     // string[]
  stateDeltas   Json     // StateDelta[]
  metadata      Json?    // full ChapterMemory
  createdAt     DateTime @default(now())
  novel         Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, chapterNumber])
}

// ====================================================================
// Phase 9: Knowledge State — per-character POV knowledge
// ====================================================================

model KnowledgeStateRecord {
  id            String   @id @default(cuid())
  novelId       String
  characterId   String
  asOfChapter   Int
  knowledge     Json     // KnowledgeState serialized
  isCanonical   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([novelId, characterId, asOfChapter])
  @@index([novelId, characterId, isCanonical])
}

// ====================================================================
// Phase 9: Quality Gate result per prose version
// ====================================================================

model ProseQualityGate {
  id                   String   @id @default(cuid())
  chapterProseVersionId String
  chapterId            String
  novelId              String
  result               String   // PASS | WARN | FAIL
  report               Json     // QualityGateReport
  createdAt            DateTime @default(now())

  @@index([novelId, chapterId])
  @@index([chapterProseVersionId])
}

// ====================================================================
// Phase 10: Quality Snapshot — immutable per-chapter quality record
// ====================================================================

model QualitySnapshotRecord {
  id            String   @id @default(cuid())
  novelId       String
  chapterId     String?
  chapterNumber Int?
  correlationId String   @unique
  score         Json     // QualityScore
  healthStatus  String   // QualityHealthStatus
  issueCount    Int      @default(0)
  overallScore  Float    @default(0)
  createdAt     DateTime @default(now())

  issues  QualityIssueRecord[]
  novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, chapterNumber])
  @@index([novelId, createdAt])
}

// ====================================================================
// Phase 10: Quality Issue — individual detected issue
// ====================================================================

model QualityIssueRecord {
  id            String   @id @default(cuid())
  novelId       String
  snapshotId    String
  chapterId     String?
  chapterNumber Int?
  sceneId       String?
  issueType     String   // QualityIssueType
  severity      String   // QualityIssueSeverity
  confidence    Float
  evidence      Json     // string[]
  affectedEntities Json  // string[]
  repairStrategy String  // RepairStrategy
  isAutoRepairable Boolean @default(false)
  requiresLLM   Boolean  @default(true)
  detectedBy    String
  resolved      Boolean  @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  snapshot QualitySnapshotRecord @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([novelId, chapterId])
  @@index([novelId, issueType])
  @@index([snapshotId])
}

// ====================================================================
// Phase 10: Content Fingerprint — for repetition detection
// ====================================================================

model ContentFingerprintRecord {
  id            String   @id @default(cuid())
  novelId       String
  chapterId     String
  chapterNumber Int
  sceneId       String?
  fingerprint   String
  category      String   // SCENE | DIALOGUE | DESCRIPTION | ENDING | BEAT
  contentPreview String  // first ~200 chars
  createdAt     DateTime @default(now())

  @@index([novelId, fingerprint])
  @@index([novelId, category, chapterNumber])
  @@unique([novelId, chapterId, category])
}

// ====================================================================
// Phase 10: Repair Plan — what will be repaired and why
// ====================================================================

model RepairPlanRecord {
  id            String   @id @default(cuid())
  novelId       String
  chapterId     String
  chapterNumber Int
  decision      String   // RepairDecision
  primaryStrategy String // RepairStrategy
  targetDimensions Json  // string[]
  estimatedTokens Int    @default(0)
  estimatedCostUsd Float @default(0)
  budgetApproved  Boolean @default(false)
  reason        String
  issueIds      Json     // string[]
  createdAt     DateTime @default(now())

  attempts RepairAttemptRecord[]

  @@index([novelId, chapterId])
}

// ====================================================================
// Phase 10: Repair Attempt — outcome of each repair execution
// ====================================================================

model RepairAttemptRecord {
  id                   String   @id @default(cuid())
  novelId              String
  chapterId            String
  chapterProseVersionId String
  repairPlanId         String
  strategy             String
  attemptNumber        Int      @default(1)
  outcome              String   // RepairOutcome
  originalScore        Float
  candidateScore       Float?
  improvement          Float?
  candidateFingerprint String?
  createdAt            DateTime @default(now())

  repairPlan RepairPlanRecord @relation(fields: [repairPlanId], references: [id], onDelete: Cascade)

  @@index([novelId, chapterId])
  @@index([repairPlanId])
}

// ====================================================================
// Phase 10: Quality Trend — rolling window trend record
// ====================================================================

model QualityTrendRecord {
  id             String   @id @default(cuid())
  novelId        String
  windowStart    Int
  windowEnd      Int
  direction      String   // IMPROVING | STABLE | DEGRADING
  healthStatus   String   // QualityHealthStatus
  averageScore   Float
  minScore       Float
  maxScore       Float
  consecutiveDrops Int    @default(0)
  recoveryDetected Boolean @default(false)
  scores         Json     // {chapterNumber, overall}[]
  createdAt      DateTime @default(now())

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, windowEnd])
  @@index([novelId, createdAt])
}

// ====================================================================
// Phase 11: Long-Horizon Plan — overlay on existing StoryPlan
// ====================================================================

model LongHorizonPlan {
  id                  String   @id @default(cuid())
  novelId             String
  storyPlanVersionId  String
  version             Int      @default(1)
  title               String
  premise             String
  genre               String?
  narrativePromise    String
  globalObjective     String
  activeArcId         String?
  plannedArcCount     Int      @default(0)
  status              String   @default("DRAFT")  // DRAFT | ACTIVE | SUPERSEDED
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  novel       Novel            @relation(fields: [novelId], references: [id], onDelete: Cascade)
  arcPlans    StoryArcPlan[]
  objectives  ChapterObjectiveRecord[]
  decisions   PlanningDecisionRecord[]
  snapshots   PlanningQualitySnapshotRecord[]
  reconciliations PlanReconciliationRecord[]

  @@index([novelId, status])
  @@unique([novelId, version])
}

// ====================================================================
// Phase 11: Story Arc Plan
// ====================================================================

model StoryArcPlan {
  id                   String   @id @default(cuid())
  longHorizonPlanId    String
  novelId              String
  arcNumber            Int
  title                String
  purpose              String
  objective            String
  conflict             String
  stakes               String
  entryConditions      Json     // string[]
  exitConditions       Json     // string[]
  plannedChapterStart  Int
  plannedChapterEnd    Int
  actualChapterStart   Int?
  actualChapterEnd     Int?
  status               String   @default("PLANNED")  // ArcStatus
  priority             Int      @default(5)
  allowExtension       Boolean  @default(true)
  maxExtensionChapters Int      @default(20)
  characterFocusIds    Json     // string[]
  threadFocusIds       Json     // string[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  plan       LongHorizonPlan @relation(fields: [longHorizonPlanId], references: [id], onDelete: Cascade)
  milestones NarrativeMilestoneRecord[]
  charArcs   Phase11CharacterArcPlan[]
  objectives ChapterObjectiveRecord[]

  @@index([novelId, status])
  @@index([longHorizonPlanId, arcNumber])
}

// ====================================================================
// Phase 11: Chapter Objective
// ====================================================================

model ChapterObjectiveRecord {
  id                  String   @id @default(cuid())
  novelId             String
  chapterNumber       Int
  longHorizonPlanId   String
  arcPlanId           String?
  primaryObjective    String
  secondaryObjectives Json     // string[]
  requiredEvents      Json     // string[]
  forbiddenEvents     Json     // string[]
  characterGoals      Json     // {characterId, goal}[]
  plotThreadGoals     Json     // {threadId, advancement}[]
  requiredStateChanges Json    // {entityType, entityId, property, expectedValue}[]
  setupActions        Json     // string[]
  payoffActions       Json     // string[]
  tensionTarget       String   @default("MEDIUM")
  endingTarget        String
  dependencies        Json     // chapterObjectiveId[]
  status              String   @default("DRAFT")
  completionScore     Float?
  createdAt           DateTime @default(now())

  plan    LongHorizonPlan @relation(fields: [longHorizonPlanId], references: [id], onDelete: Cascade)
  arcPlan StoryArcPlan?   @relation(fields: [arcPlanId], references: [id], onDelete: SetNull)

  @@index([novelId, chapterNumber])
  @@index([longHorizonPlanId, status])
}

// ====================================================================
// Phase 11: Character Arc Plan (Phase 11 detailed)
// ====================================================================

model Phase11CharacterArcPlan {
  id                     String   @id @default(cuid())
  novelId                String
  characterId            String
  arcPlanId              String?
  startingState          String
  currentState           String
  targetState            String
  milestones             Json     // {id, description, plannedChapter, achieved}[]
  internalConflict       String
  externalConflict       String
  relationshipMilestones Json     // {targetCharacterId, milestone, planned, achieved}[]
  turningPoints          Json     // {description, plannedChapter, triggered}[]
  resolutionCriteria     String
  status                 String   @default("ACTIVE")
  progressScore          Float    @default(0)
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())

  arcPlan StoryArcPlan? @relation(fields: [arcPlanId], references: [id], onDelete: SetNull)

  @@index([novelId, characterId])
  @@index([arcPlanId])
}

// ====================================================================
// Phase 11: Narrative Milestone
// ====================================================================

model NarrativeMilestoneRecord {
  id                  String   @id @default(cuid())
  novelId             String
  arcPlanId           String?
  milestoneType       String
  title               String
  description         String
  plannedChapterMin   Int
  plannedChapterMax   Int
  actualChapter       Int?
  status              String   @default("PLANNED")
  prerequisites       Json     // milestone ID[]
  consequences        Json     // string[]
  involvedEntityIds   Json     // string[]
  priority            Int      @default(5)
  isOptional          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  arcPlan StoryArcPlan? @relation(fields: [arcPlanId], references: [id], onDelete: SetNull)

  @@index([novelId, status])
  @@index([arcPlanId])
}

// ====================================================================
// Phase 11: Foreshadowing Plan (Phase 11 detailed)
// ====================================================================

model ForeshadowingPlanRecord {
  id                    String   @id @default(cuid())
  novelId               String
  targetMilestoneId     String?
  targetObligationId    String?
  setupType             String
  plannedSetupChapters  Json     // number[]
  minimumOccurrences    Int      @default(1)
  actualSetupCount      Int      @default(0)
  revealWindowStart     Int
  revealWindowEnd       Int
  payoffWindowStart     Int
  payoffWindowEnd       Int
  strength              String   @default("MODERATE")
  status                String   @default("PLANNED")
  description           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([novelId, status])
}

// ====================================================================
// Phase 11: Narrative Obligation
// ====================================================================

model NarrativeObligationRecord {
  id                       String   @id @default(cuid())
  novelId                  String
  obligationType           String
  description              String
  establishedChapter       Int
  establishedBy            String
  targetResolutionChapter  Int?
  latestResolutionChapter  Int?
  status                   String   @default("OPEN")
  progressNotes            Json     // string[]
  involvedEntityIds        Json     // string[]
  dependentObligationIds   Json     // string[]
  priority                 Int      @default(5)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([novelId, status])
}

// ====================================================================
// Phase 11: Plan Reconciliation — post-chapter evaluation
// ====================================================================

model PlanReconciliationRecord {
  id                       String   @id @default(cuid())
  novelId                  String
  chapterNumber            Int
  chapterObjectiveId       String
  longHorizonPlanId        String
  deviationType            String   // DeviationType
  objectiveCompletionScore Float
  completedRequiredEvents  Json     // string[]
  missedRequiredEvents     Json     // string[]
  forbiddenEventsTriggered Json     // string[]
  milestonesTriggered      Json     // string[]
  milestonesInvalidated    Json     // string[]
  obligationsProgressed    Json     // string[]
  obligationsSatisfied     Json     // string[]
  foreshadowingDelivered   Json     // string[]
  foreshadowingPaidOff     Json     // string[]
  requiresReplanning       Boolean  @default(false)
  replanningReason         String?
  createdAt                DateTime @default(now())

  plan LongHorizonPlan @relation(fields: [longHorizonPlanId], references: [id], onDelete: Cascade)

  @@index([novelId, chapterNumber])
  @@index([longHorizonPlanId])
}

// ====================================================================
// Phase 11: Planning Quality Snapshot
// ====================================================================

model PlanningQualitySnapshotRecord {
  id                       String   @id @default(cuid())
  novelId                  String
  chapterNumber            Int?
  longHorizonPlanId        String
  objectiveClarity         Float
  milestoneProgression     Float
  obligationHealth         Float
  foreshadowingHealth      Float
  characterArcProgression  Float
  plotProgression          Float
  planAdherence            Float
  adaptability             Float
  overall                  Float
  createdAt                DateTime @default(now())

  plan LongHorizonPlan @relation(fields: [longHorizonPlanId], references: [id], onDelete: Cascade)

  @@index([novelId, chapterNumber])
}

// ====================================================================
// Phase 11: Planning Decision Log
// ====================================================================

model PlanningDecisionRecord {
  id                  String   @id @default(cuid())
  novelId             String
  longHorizonPlanId   String
  decisionType        String
  summary             String
  rationale           String
  previousState       Json
  newState            Json
  affectedArcIds      Json     // string[]
  affectedChapterMin  Int
  affectedChapterMax  Int
  wasLLMAssisted      Boolean  @default(false)
  validationPassed    Boolean  @default(true)
  createdAt           DateTime @default(now())

  plan LongHorizonPlan @relation(fields: [longHorizonPlanId], references: [id], onDelete: Cascade)

  @@index([novelId, decisionType])
}

// ====================================================================
// Phase 12: Causality Engine & Dynamic World
// ====================================================================

model CausalEventRecord {
  id            String   @id @default(cuid())
  novelId       String
  chapterNumber Int
  sceneId       String?
  eventType     String   // CausalEventType
  actorIds      Json     // string[]
  targetIds     Json     // string[]
  locationId    String?
  stateChanges  Json     // StateDelta[]
  importance    String   // ImportanceLevel
  provenance    String
  createdAt     DateTime @default(now())

  @@index([novelId, chapterNumber])
  @@index([novelId, eventType])
}

model CausalRelationRecord {
  id                 String   @id @default(cuid())
  novelId            String
  causeEventId       String
  effectEventId      String
  relationType       String   // RelationType
  strength           Float    // 0.0 to 1.0
  confidence         Float    // 0.0 to 1.0
  temporalConstraint String?
  provenance         String
  createdAt          DateTime @default(now())

  @@index([novelId, causeEventId])
  @@index([novelId, effectEventId])
}

model ConsequenceRecord {
  id                   String   @id @default(cuid())
  novelId              String
  sourceEventId        String
  consequenceType      String   // ConsequenceType
  targetEntityId       String?
  expectedChapterRange Json?    // {min, max}
  severity             Float    // 0.0 to 1.0
  probability          Float    // 0.0 to 1.0
  status               String   // ConsequenceStatus
  description          String
  provenance           String
  createdAt            DateTime @default(now())

  @@index([novelId, status])
  @@index([novelId, sourceEventId])
}

model WorldTransitionRecord {
  id             String   @id @default(cuid())
  novelId        String
  entityId       String
  transitionType String   // WorldTransitionType
  beforeState    Json
  afterState     Json
  causeEventId   String
  chapterNumber  Int
  reversible     Boolean  @default(false)
  provenance     String
  createdAt      DateTime @default(now())

  @@index([novelId, entityId])
  @@index([novelId, chapterNumber])
}

model CausalDependencyRecord {
  id                String   @id @default(cuid())
  novelId           String
  prerequisite      String
  dependentEntityId String
  dependencyType    String   // DependencyType
  status            String   // DependencyStatus
  provenance        String
  createdAt         DateTime @default(now())

  @@index([novelId, status])
  @@index([novelId, dependentEntityId])
}

model PlanImpactRecord {
  id                      String   @id @default(cuid())
  novelId                 String
  causalEventId           String
  affectedArcId           String?
  affectedObjectiveIds    Json     // string[]
  affectedMilestoneIds    Json     // string[]
  affectedObligationIds   Json     // string[]
  affectedCharacterArcIds Json     // string[]
  severity                String
  recommendedAction       String
  reasoning               String
  createdAt               DateTime @default(now())

  @@index([novelId, causalEventId])
}

model CausalAnalysisRecord {
  id                        String   @id @default(cuid())
  novelId                   String
  chapterNumber             Int
  analysisType              String   // CausalAnalysisType
  eventsGenerated           Int      @default(0)
  consequencesGenerated     Int      @default(0)
  dependenciesInvalidated   Int      @default(0)
  worldTransitionsGenerated Int      @default(0)
  planImpactsGenerated      Int      @default(0)
  healthScoreId             String?  @unique
  executionMs               Int
  createdAt                 DateTime @default(now())

  @@index([novelId, chapterNumber])
}

model CausalHealthScoreRecord {
  id                          String   @id @default(cuid())
  novelId                     String
  chapterNumber               Int
  orphanConsequences          Int      @default(0)
  unresolvedMajorConsequences Int      @default(0)
  causalContradictions        Int      @default(0)
  ignoredReactions            Int      @default(0)
  staleDependencies           Int      @default(0)
  impossibleDependencies      Int      @default(0)
  overallHealth               Float    // 0.0 to 1.0
  createdAt                   DateTime @default(now())

  @@index([novelId, chapterNumber])
}
