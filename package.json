{
  "name": "ai-novel-engine",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "project:doctor": "node scripts/doctor.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:db": "vitest run tests/integration/migration.test.ts tests/integration/phase1_db.test.ts tests/integration/phase1_rls.test.ts tests/integration/rls.test.ts tests/integration/mvp_pipeline_db.test.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.21.0",
    "eslint": "^9",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "pnpm": {
    "approvedBuilds": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
