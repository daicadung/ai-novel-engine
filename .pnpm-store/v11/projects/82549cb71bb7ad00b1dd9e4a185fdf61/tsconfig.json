{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@ai-novel-engine/chapter-writer": ["../../packages/chapter-writer/src/index.ts"],
      "@ai-novel-engine/concept-engine": ["../../packages/concept-engine/src/index.ts"],
      "@ai-novel-engine/config": ["../../packages/config/src/index.ts"],
      "@ai-novel-engine/domain": ["../../packages/domain/src/index.ts"],
      "@ai-novel-engine/generation-orchestrator": ["../../packages/generation-orchestrator/src/index.ts"],
      "@ai-novel-engine/llm-gateway": ["../../packages/llm-gateway/src/index.ts"],
      "@ai-novel-engine/longform-planner": ["../../packages/longform-planner/src/index.ts"],
      "@ai-novel-engine/memory-continuity": ["../../packages/memory-continuity/src/index.ts"],
      "@ai-novel-engine/mvp-pipeline": ["../../packages/mvp-pipeline/src/index.ts"],
      "@ai-novel-engine/story-architect": ["../../packages/story-architect/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
